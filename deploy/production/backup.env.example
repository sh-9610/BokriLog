# 일일 백업 설정 견본 — Story 3.9.
#
# 운영자가 저장소 밖(`/etc/bokrilog/backup/backup.env`, `BOKRILOG_BACKUP_CONFIG`)에 둔다. 값은 비밀이 아니다 — 저장소 자격정보는
# 같은 디렉터리의 `rclone.conf`(권한 600)에만 있고 이 파일에는 remote 이름만 적는다. 알 수 없는 키가 있으면 백업이 준비 실패로 끝난다.
#
# oci_remote, offsite_remote   -- rclone remote와 bucket(`<remote>:<bucket>[/경로]`, 끝의 `/`·`//` 금지). OCI Object Storage 하나와
#                                 OCI 밖 S3 호환 저장소 하나이고 **서로 다른 rclone remote**여야 한다(같은 remote의 다른 경로는 이중
#                                 보관이 아니다). 저장소 업체는 아직 정하지 않았다(실저장소 미검증).
# max_generations              -- 저장소마다 남길 generation 수의 상한. 넘으면 오래된 것부터 지운다(마지막 성공 하나는 남긴다).
#                                 하루 한 번에 29일 보존이면 30개 안팎이다.
# max_bytes_oci, max_bytes_offsite      -- 저장소마다 백업 object 총 bytes의 상한. 넘으면 오래된 것부터 지운다(마지막 성공 하나는
#                                          남긴다). quota보다 클 수 없다.
# quota_bytes_oci, quota_bytes_offsite  -- 저장소의 용량 한도(10진 바이트). 사용률 gauge의 분모다(70% warning·85% critical). OCI
#                                          무료 Object Storage는 계정 합산 20 GB = 20000000000이다. 사용률의 분자는 **이 백업
#                                          object(generations/·incoming/)뿐이다** — 같은 계정의 다른 bucket이 쓰는 몫은 세지 않으므로
#                                          계정 전체 사용률이 아니다(후속 작업, deferred-work.md).
#
# 30일 규칙(생성 후 29일을 넘으면 지운다, 30일을 넘긴 것이 남으면 기한 초과)은 설정이 아니다 — `backup.sh`가 고정한다.

oci_remote=oci:bokrilog-backup
offsite_remote=offsite:bokrilog-backup
max_generations=35
max_bytes_oci=10000000000
max_bytes_offsite=10000000000
quota_bytes_oci=20000000000
quota_bytes_offsite=20000000000
