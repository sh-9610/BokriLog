# 운영 호스트 사실 견본 — Story 3.8 AC-2.
#
# 운영자가 OCI 콘솔에서 확인한 값을 저장소 밖(`/etc/bokrilog/host-facts.env`, `BOKRILOG_HOST_FACTS`)에 적는다. gate가 하나라도
# 어긋나면 배포를 거부한다. 콘솔 확인 자체를 이 파일이 대신하지 않는다 — 선언이 사실과 다르면 gate도 틀린다.
#
# home_region, region  -- tenancy의 home region과 이 인스턴스의 region. 같아야 한다(Always Free A1은 home region에서만).
# shape                -- `VM.Standard.A1.Flex`.
# ocpus, memory_gb     -- 2와 12.
# reserved_ip          -- regional reserved public IPv4(Nginx 진입점과 Bybit egress가 같은 주소다).
# always_free          -- 콘솔의 Always Free 표시가 있으면 `true`.
# expected_monthly_cost_krw -- 콘솔 비용 예측. 0이어야 한다.
# os_reserved_mib      -- OS·Docker 데몬에 남겨 둘 메모리. blue/green peak에 더해 memory_gb 안이어야 한다.
# signer_identity, signer_issuer
#                      -- 운영 이미지 서명 인증서의 identity와 OIDC issuer. gate가 `cosign verify`와 SBOM attestation 검증
#                         (`cosign verify-attestation --type spdxjson`)에 넘긴다. 서명 공급자를 정한 운영자가 적는다(리허설은 쓰지 않는다).
#
# 아래 값은 견본이다. 주소는 문서용(RFC 5737 TEST-NET-3)이다.

home_region=ap-chuncheon-1
region=ap-chuncheon-1
shape=VM.Standard.A1.Flex
ocpus=2
memory_gb=12
reserved_ip=203.0.113.10
always_free=true
expected_monthly_cost_krw=0
os_reserved_mib=1024
signer_identity=<서명 인증서의 identity>
signer_issuer=<서명 인증서의 OIDC issuer>
