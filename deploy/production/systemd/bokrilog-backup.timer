# BokriLog 일일 백업 timer(Story 3.9). 매일 18:30 UTC(03:30 KST)에 `bokrilog-backup.service`를 띄운다.
#
# `Persistent=true` — 서버가 꺼져 있어 놓친 실행은 다음 기동 때 한 번 돈다. 같은 날 다시 돌아도 이미 성공한 generation이면 no-op이고,
# 배포 중이면 시작하지 않고 실패로 끝난다(다음 timer가 다시 돈다). 26시간 안에 성공이 없으면 `BackupAgeExceeded`가 울린다.
[Unit]
Description=BokriLog daily encrypted backup timer (Story 3.9)

[Timer]
OnCalendar=*-*-* 18:30:00 UTC
Persistent=true
RandomizedDelaySec=10m
Unit=bokrilog-backup.service

[Install]
WantedBy=timers.target
