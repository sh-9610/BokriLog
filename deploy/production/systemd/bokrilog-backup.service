# BokriLog 일일 암호화 백업(Story 3.9). `bokrilog-backup.timer`가 하루 한 번 띄운다. 설치는 `DEVELOPMENT.md`의 `## 백업`.
#
# 경로는 운영 호스트의 checkout(`/srv/bokrilog`)을 가정한다. 다르면 설치할 때 `ExecStart`·`WorkingDirectory`를 그 경로로 바꾼다.
# 실행 계정은 배포를 돌리는 운영 계정(docker 그룹)이다. backup key·저장소 설정(`/etc/bokrilog/backup/`)은 그 계정만 읽는다(700·600).
# 환경에는 경로와 수행자 이름만 있다 — key·자격정보 값을 unit에 적지 않는다.
[Unit]
Description=BokriLog daily encrypted backup (Story 3.9)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# 실패(단계 실패·배포 중·기록 실패)는 30분 뒤 다시 돈다 — 하루를 기다려 26시간 경보가 울리지 않게. 다시 돌기는 12시간에 6번까지다:
# 성공한 날의 재시작은 같은 날 no-op(종료 0)이라 거기서 멈추고, 파기 실패만 남은 날이나 LOCK_STALE도 이 상한에서 멈춘다.
StartLimitIntervalSec=12h
StartLimitBurst=6

[Service]
Type=oneshot
User=bokrilog
Group=bokrilog
UMask=0077
WorkingDirectory=/srv/bokrilog
Environment=BOKRILOG_BACKUP_KEYS_DIR=/etc/bokrilog/backup
Environment=BOKRILOG_BACKUP_DIR=/var/lib/bokrilog/backup
Environment=BOKRILOG_BACKUP_TOOLS=/opt/bokrilog/backup-tools
Environment=BOKRILOG_STATE_DIR=/var/lib/bokrilog/deploy
Environment=BOKRILOG_SECRETS_FILE=/etc/bokrilog/production.env
Environment=BOKRILOG_BACKUP_ACTOR=backup-timer
ExecStart=/usr/bin/env bash /srv/bokrilog/deploy/production/backup.sh run
Restart=on-failure
RestartSec=30min
# dump·업로드가 길어도 3시간을 넘기지 않는다. 넘기거나 멈추면 SIGTERM — 스크립트는 긴 단계를 배경에서 기다리므로 바로 그 단계를 끝내고
# 임시본(평문 포함)을 지운 뒤 `FAILED INTERRUPTED`를 기록하고(기록 역할 JVM 기동 몫으로 90초, 못 하면 대기열) 잠금을 놓는다. 정지 유예는
# 그보다 길게 둔다 — 넘기면 SIGKILL이라 정리가 잘린다.
TimeoutStartSec=3h
TimeoutStopSec=180
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
