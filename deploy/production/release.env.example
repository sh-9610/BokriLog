# 운영 배포 입력(release manifest) 견본 — Story 3.8 AC-1.
#
# 배포 하나가 이 파일 하나를 입력으로 받는다(`deploy.sh deploy --release <파일>`). `key=value` 한 줄씩이고 jq가 필요 없다. 값에
# 따옴표를 쓰지 않는다. 아래 키 밖의 키·중복 키는 gate가 거부한다. 이 견본의 `<…>` 자리는 그대로 두면 gate가 거부한다.
#
# image             -- API 두 슬롯·Worker·migrate·감사 역할이 모두 쓰는 이미지 하나. `<repo>@sha256:<64자 소문자 16진>`만 받는다
#                      (tag·`latest` 금지). gate가 실제 이미지의 OS/아키텍처가 아래 platform인지 본다.
# platform          -- `linux/arm64` 고정.
# migration_version -- 이 이미지가 담은 마지막 Flyway 버전(정수). migrate 뒤 `flyway_schema_history`의 최대 버전과 같아야 한다.
# migration_kind    -- `expand` 또는 `contract`. contract는 rollback 창(`deploy.sh close-window`)이 닫혀 있고 migration을 정확히
#                      하나 더할 때만 받는다 — contract와 expand를 한 배포에서 실행하지 않는다.
# sbom, sbom_sha256 -- 이 파일과 같은 디렉터리의 SBOM 파일 이름과 그 SHA-256.
# signature, signature_sha256
#                   -- 서명 묶음 파일 이름과 그 SHA-256.
# 서명 신원(signer_identity·signer_issuer)은 이 파일에 두지 않는다. manifest는 서명되지 않은 입력이라 그것을 고친 사람이 신원을
# 고르게 된다 — 운영자가 소유한 host 사실(`host-facts.env`)에 있다. 이 파일에 있으면 gate가 알 수 없는 키로 거부한다.
#
# 이미지 빌드·SBOM 생성·서명(SBOM attestation 포함)·레지스트리 게시는 이 저장소의 CI가 아직 하지 않는다(`deferred-work.md`, 공급망 파이프라인). 그
# 파이프라인이 이 파일을 만들 때까지 운영 배포는 **미검증**이다.

image=<registry>/<repository>@sha256:<64자 소문자 16진>
platform=linux/arm64
migration_version=<정수>
migration_kind=expand
sbom=<SBOM 파일 이름>
sbom_sha256=<64자 소문자 16진>
signature=<서명 묶음 파일 이름>
signature_sha256=<64자 소문자 16진>
