{
  "name": "bokrilog-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BokriLog 정적 SPA. Story 1.1 진입 화면과 DESIGN.md 토큰 기반.",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:css": "stylelint --max-warnings 0 \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "~8.2.2",
    "vitest": "^4.1.11"
  }
}
